@section Scripts {
    <script>
        $('#editProjectModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            $.get('/Home/GetProject/' + id, function (data) {
                $('#ProjectId').val(data.id);
                $('#ProjectName').val(data.projectName);
                $('#ProjectUserId').val(data.userId);
                $('#Note').val(data.note);
                $('#Weight').val(data.weight);


            });
        });
        $('#editTaskModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            $.get('/Home/GetTask/' + id, function (data) {
                 console.log("---data---: ",data);
                $('#TaskId').val(data.id);
                $('#TaskName').val(data.taskName);
                $('#TaskStatus').val(data.status);
                $('#TaskUserId').val(data.userId);
                $('#modalProjectId').val(data.projectId);
                $('#modalStatus').val(data.status);

               
                $('#EstimatedDate').val(data.estimatedDate ? data.estimatedDate.substring(0, 10) : '');
                $('#StartedOn').val(data.startedOn ? data.startedOn.substring(0, 10) : '');
               $('#FinishedOn').val(data.finishedOn ? data.finishedOn.substring(0, 10) : '');
            });
        });
    </script>
    <script>
        //this for add task from project table
        var addTaskModal = document.getElementById('addTaskModel');
        addTaskModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget; 
            var projectId = button.getAttribute('data-project-id');
            var developerId = button.getAttribute('data-developer-id');   
            
            var selectProject = addTaskModal.querySelector('#modalProjectId');
            if (selectProject && projectId) {
                selectProject.value = projectId;
            }
            
            var selectUser = addTaskModal.querySelector('#modalUserId');
            if (selectUser) {
                selectUser.value = developerId ? developerId : "";
            }
        });
    </script>




    <script>
        //this for add task when choose project get the assigend dev

        $(document).on('change', '#modalProjectId', function () {
           let projectId = $(this).val();
           let $devIdInput = $('#modalUserId2');
           let $devNameInput = $('#modalUserId2display');
           
           $devIdInput.val('');
           $devNameInput.val('');
           if (!projectId) {
               return;
           }
           $.ajax({
               url: '/Tasks/GetDevelopersByProject',
               type: 'GET',
               data: { projectId: projectId },
               success: function (data) {
                   if (data && data.length > 0) {
                       let dev = data[0];
                       let devId = dev.id || dev.Id;
                       let devName = dev.userName || dev.UserName;
                       if (devId && devName) {
                           $devIdInput.val(devId);
                           $devNameInput.val(devName);
                       } else {
                           
                           $devNameInput.val('');
                       }
                   } else {
                      
                       $devIdInput.val('');
                       $devNameInput.val('');
                   }
               },
               error: function (xhr) {
                   console.error("Error:", xhr.responseText);
               }
           });
        });
       // rest when close model
        $('#addTaskModel2').on('hidden.bs.modal', function () {
           
           $(this).find('form')[0].reset();
          
           $('#modalUserId2').val('');
           $('#modalUserId2display').val('');
        });
 

   
    </script>
    
}