@model PMSProject.Models.TaskAndProjectViewModel
@{
    ViewData["Title"] = "Dashboard - Tasks & Projects";
}
<div class="container mt-4">
    <h2 class="mb-4">Dashboard</h2>

    <div class="row">
        <!-- Projects Section -->
        <div class="col">
            <a asp-controller="Projects" asp-action="IndexP" class="btn btn-primary rounded-pill px-4">
                List of Projects
            </a>
            <a asp-controller="Projects" asp-action="CreateP" class="btn btn-primary rounded-pill px-4">
                Submit New Project
            </a>
            <button type="button" class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addProjectModal">
                + Add project (model)
            </button>
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Projects</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Project Name</th>
                                <th>Parent Project</th>
                                <th>Delvolper</th>

                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Projects != null && Model.Projects.Any())
                            {
                                @foreach (var project in Model.Projects)
                                {
                                    <tr>
                                        <td>@project.ProjectName</td>
                                        <td>
                                            @if(project.ParentProject != null)
                                            {
                                                <span class="text-dark">@project.ParentProject.ProjectName</span>

                                            }
                                            else
                                            {
                                                <span class="text-dark">Main Project</span>

                                            }
                                        </td>
       
                                        <td>
                                            @if (project.AssignedUser != null)
                                            {
                                                @string.Join(", ", project.AssignedUser)

                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td>

                                            <button class="btn btn-sm btn-danger" asp-action="DeleteP" asp-route-id="@project.Id">Delete</button>
                                            <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#editProjectModal" data-id="@project.Id">
                                                Edit
                                            </button>
                                            <button type="button" class="btn btn-success btn-sm" 
                                            data-bs-toggle="modal"
                                                    data-bs-target="#addTaskModel"
                                                    data-project-id="@project.Id"
                                                    data-developer-id="@project.UserId">
                                               Add Task(model)
                                            </button>
                                            <a asp-controller="Projects" asp-action="DetailsP" asp-route-id="@project.Id" class="btn btn-sm btn-primary ">
                                                Detalis
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted">No projects available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
        <!--Direct Tasks Section-->
    <div class="row">
        <div class="col">
            <a asp-controller="Tasks" asp-action="CreateT" class="btn btn-secondary rounded-pill px-4">
                Submit New Task
            </a>
            <a asp-controller="Tasks" asp-action="IndexT" class="btn btn-secondary rounded-pill px-4">
                List of tasks
            </a>
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addTaskModel2">
                + Add Task (model)
            </button>
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h4 class="mb-0">Direct Tasks</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Task Title</th>
                                <th>Parent Project</th>
                                <th>sub-Project</th>
                                <th>Stage</th> 
                                <th>Developer</th>
                                <th>Sprint</th>
                                <th>Status</th>
                                <th>Estimated Date</th>
                                <th>Started On</th>
                                <th>Finished On</th>
                                <th>Over Due</th><!--new     not in taskmodel-->
                                <th>Actions</th>

                            </tr>
                        </thead>
                        <tbody>
                          
                            @if (Model.DirectTasks != null && Model.DirectTasks.Any())
                            {
                                @foreach (var task in Model.DirectTasks)
                                {
                                    <tr>
                                        <td>
                                            <strong>@task.TaskName</strong><br />

                                        </td>
                                        <td>-</td>
                                        <td>-</td>

                                        <td><span class="badge bg-secondary">@task.Stage</span></td> @* stage *@
                                        <td>
                                            @if (task.AssignedUser != null)
                                            {
                                                @task.AssignedUser.UserName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (task.Sprint != null)
                                            {
                                                <span>@task.Sprint.SprintName</span>
                                            }
                                            else
                                            {
                                                <span>No Sprint </span>
                                            }
                                        </td>
                                        <td><span class="badge bg-secondary">@task.Status</span></td>
                                        <td>@task.EstimatedDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@task.StartedOn?.ToString("yyyy-MM-dd")</td>
                                        <td>@task.FinishedOn?.ToString("yyyy-MM-dd")</td>
                                        <td></td> @* Over Due  *@
                                        @*                                         <td>
                                            @if (task.EstimatedDate < DateTime.Now && task.Status != "Done")
                                            {
                                                <span class="text-danger fw-bold">متأخر</span>
                                            }
                                            else
                                            {
                                                <span class="text-success">منتظم</span>
                                            }
                                        </td> *@
                                        <td>
                                            <a class="btn btn-sm btn-danger" asp-controller="Tasks" asp-action="DeleteT" asp-route-id="@task.Id">Delete</a>
                                            <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#editTaskModal" data-id="@task.Id">
                                                Edit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="text-center text-muted">No tasks available.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
        <!-- Project Tasks Section -->
        <div class="row">
        <div class="col">
            <a asp-controller="Tasks" asp-action="CreateT" class="btn btn-success rounded-pill px-4">
