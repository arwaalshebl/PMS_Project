@model PMSProject.Models.TaskAndProjectViewModel
@{
    ViewData["Title"] = "Dashboard - Tasks & Projects";
}
<div class="container mt-4">
    <h2 class="mb-4">Dashboard</h2>

    <div class="row">
        <!-- Projects Section -->
        <div class="col">
            <a asp-controller="Projects" asp-action="IndexP" class="btn btn-primary rounded-pill px-4">
                List of Projects
            </a>
            <a asp-controller="Projects" asp-action="CreateP" class="btn btn-primary rounded-pill px-4">
                Submit New Project
            </a>
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Projects</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Project Name</th>
                                <th>Parent Project</th>
                                <th>Delvolper</th>

                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Projects != null && Model.Projects.Any())
                            {
                                @foreach (var project in Model.Projects)
                                {
                                    <tr>
                                        <td>@project.ProjectName</td>
                                        <td>
                                            @if(project.ParentProject != null)
                                            {
                                                <span class="text-dark">@project.ParentProject.ProjectName</span>

                                            }
                                            else
                                            {
                                                <span class="text-dark">Main Project</span>

                                            }
                                        </td>
       
                                        <td>
                                            @if (project.AssignedUser != null)
                                            {
                                                @string.Join(", ", project.AssignedUser)

                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td>

                                            <button class="btn btn-sm btn-danger" asp-action="DeleteP" asp-route-id="@project.Id">Delete</button>
                                            <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#editProjectModal" data-id="@project.Id">
                                                Edit
                                            </button>
                                            <button type="button" class="btn btn-success btn-sm" 
                                            data-bs-toggle="modal"
                                                    data-bs-target="#addTaskModel"
                                                    data-project-id="@project.Id"
                                                    data-developer-id="@project.UserId">
                                               Add Task
                                            </button>
                                            <a asp-controller="Projects" asp-action="DetailsP" asp-route-id="@project.Id" class="btn btn-sm btn-primary ">
                                                Detalis
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted">No projects available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
        <!-- Tasks Section -->
        <div class="row">
        <div class="col">
            <a asp-controller="Tasks" asp-action="CreateT" class="btn btn-success rounded-pill px-4">
                Submit New Task
            </a>
            <a asp-controller="Tasks" asp-action="IndexT" class="btn btn-success rounded-pill px-4">
                List of tasks
            </a>
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Tasks</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Task Title</th>
                                <th>Parent Project</th>
                                <th>sub-Project</th>
                                <th>Developer</th>
                                <th>Sprint</th>
                                <th>Status</th>
                                <th>Actions</th>
                                
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Tasks != null && Model.Tasks.Any())
                            {
                                @foreach (var task in Model.Tasks)
                                {
                                    <tr>
                                        <td>
                                            <strong>@task.TaskName</strong><br />
                                            
                                        </td>
                                        @* <!-- 2. المشروع الأب (Parent Project) --> *@
                                        <td>
                                            @if (task.Project?.ParentProject != null)
                                            {
                                                <span class="text-dark">@task.Project.ParentProject.ProjectName</span>
                                            }
                                            else
                                            {
                                                <span class="text-dark">-- Main Project</span>
                                            }
                                        </td>
                                        @* <!-- 3. المشروع الفرعي (Sub-Project) --> *@
                                        <td>
                                            @if (task.Project != null)
                                            {
                                                <span class="text-dark">@task.Project.ProjectName</span>
                                            }
                                            else
                                            {
                                                <span class="text-dark">No Project</span>
                                            }
                                        </td>
                                        <td>
                                            @if (task.AssignedUser != null)
                                            {
                                                @task.AssignedUser.UserName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (task.Sprint != null)
                                            {
                                                <span>@task.Sprint.SprintName</span>
                                            }
                                            else
                                            {
                                                <span>No Sprint </span>
                                            }
                                        </td>
                                        <td>@task.Status</td>
                                        <td>
                                            <a class="btn btn-sm btn-danger" asp-action="DeleteT" asp-route-id="@task.Id">Delete</a>
                                            <button type="button" class="btn btn-info btn-sm" data-bs-toggle="modal" data-bs-target="#editTaskModal" data-id="@task.Id">
                                                Edit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="text-center text-muted">No tasks available.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!--------Sprint Section------->
<a asp-controller="Sprints" asp-action="IndexS" class="btn btn-info rounded-pill px-4">List Sprint</a>
<a asp-controller="Sprints" asp-action="CreateS" class="btn btn-info rounded-pill px-4">+ Add New Sprint </a>
<div class="row">
    <div class="col">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-info text-white d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold">Sprints Overview</h6>
                
                <button type="button" class="btn btn-sm btn-light text-info fw-bold" data-bs-toggle="modal" data-bs-target="#addSprintModal">
                    + Add Sprint (model)
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle" width="100%" cellspacing="0">
                        <thead class="table-info">
                            <tr>
                                <th>Sprint Name</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Sprints != null && Model.Sprints.Any())
                            {
                                @foreach (var sprint in Model.Sprints)
                                {
                                    <tr>
                                        <td class="fw-bold">@sprint.SprintName</td>
                                        <td>@sprint.StartON?.ToShortDateString()</td>
                                        <td>@sprint.EndON?.ToShortDateString()</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No sprints available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* <!------------------- Edit ProjectModal----------------------> *@
<div class="modal fade" id="editProjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditProject" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Project</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="ProjectId" name="Id" />
                    <div class="mb-3">
                        <label class="control-label">Project Name</label>
                        <input type="text" id="ProjectName" name="ProjectName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="control-label">Assign Developer</label>
                        <select id="ProjectUserId" name="selectedUserId" class="form-control" asp-items="@(new SelectList(ViewBag.Users, "Id", "UserName"))">
                            <option value="">-- Select Developer --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-------------------edit TaskModal---------------------->

<div class="modal fade" id="editTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="EditTask" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="TaskId" name="Id" />
                    <div class="mb-3">
                        <label class="control-label">Task Name</label>
                        <input type="text" id="TaskName" name="TaskName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-control">
                            <option value="NotStarted">Not Started</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Project</label>
                        <select name="ProjectId" id="modalProjectId" class="form-control" asp-items="@(new SelectList(Model.Projects, "Id", "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="control-label">Assign Developer</label>
                        <select id="TaskUserId" name="selectedUserId" class="form-control" asp-items="@(new SelectList(ViewBag.Users, "Id", "UserName"))">
                            <option value="">-- Select Developer --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sprint</label>
                        <select name="SprintId" id="modalSprintId" class="form-control" asp-items="@(new SelectList(ViewBag.SprintsList, "Id", "SprintName"))">
                            <option value="">-- Select Sprint (Backlog) --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-------------------add Task Modal---------------------->
<div class="modal fade" id="addTaskModel" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateTaskFromDashboard" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addTaskModalLabel">Add New Task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Task Name</label>
                        <input type="text" name="TaskName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Project</label>
                        <select name="ProjectId" id="modalProjectId" class="form-control" asp-items="@(new SelectList(Model.Projects, "Id", "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-control">
                            <option value="NotStarted">Not Started</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Assign Developer</label>
                        <select name="UserId" id="modalUserId" class="form-control" asp-items="@(new SelectList(ViewBag.Users, "Id", "UserName"))">
                            <option value="">-- Unassigned --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sprint</label>
                        <select name="SprintId" id="modalSprintId" class="form-control" asp-items="@(new SelectList(ViewBag.SprintsList, "Id", "SprintName"))">
                            <option value="">-- Select Sprint (Backlog) --</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Task</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-------------------add sprint Modal---------------------->

<div class="modal fade" id="addSprintModal" tabindex="-1" aria-labelledby="addSprintModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Sprints" asp-action="CreateS" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addSprintModalLabel">Add New Sprint</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Sprint Name</label>
                        <input type="text" name="SprintName" class="form-control" required placeholder="e.g. Sprint 1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Start Date</label>
                        <input type="date" name="StartON" class="form-control"  />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">End Date</label>
                        <input type="date" name="EndON" class="form-control"  />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Sprint</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $('#editProjectModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            $.get('/Home/GetProject/' + id, function (data) {
                $('#ProjectId').val(data.id);
                $('#ProjectName').val(data.projectName);
                $('#ProjectUserId').val(data.userId);
            });
        });
        $('#editTaskModal').on('show.bs.modal', function (event) {
            var button = $(event.relatedTarget);
            var id = button.data('id');
            $.get('/Home/GetTask/' + id, function (data) {
                $('#TaskId').val(data.id);
                $('#TaskName').val(data.taskName);
                $('#TaskStatus').val(data.status);
                $('#TaskUserId').val(data.userId);
            });
        });
    </script>
    <script>
        var addTaskModal = document.getElementById('addTaskModel');
        addTaskModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget; 
            var projectId = button.getAttribute('data-project-id');
            var developerId = button.getAttribute('data-developer-id');   
            
            var selectProject = addTaskModal.querySelector('#modalProjectId');
            if (selectProject && projectId) {
                selectProject.value = projectId;
            }
            
            var selectUser = addTaskModal.querySelector('#modalUserId');
            if (selectUser) {
                selectUser.value = developerId ? developerId : "";
            }
        });
    </script>
}