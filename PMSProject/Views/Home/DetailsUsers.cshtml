@model PMSProject.Models.TaskAndProjectViewModel
<div class="container mt-4">
    <!-- معلومات المطور الأساسية -->
    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white">
            <h3> @Model.User.UserName</h3>
            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addTaskModal">
<i class="bi bi-plus-circle"></i> Add Task to User
</button>
        </div>
        <div class="card-body">
            <p><strong>Email:</strong> @Model.User.Email</p>
        </div>
    </div>

    <!-- Projects Section -->
    <div class="row">
   
        <div class="col">

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Projects</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Project Name</th>
                                <th>Parent Project</th>
                                <th>Delvolper</th>

                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Projects != null && Model.Projects.Any())
                            {
                                @foreach (var project in Model.Projects)
                                {
                                    <tr>
                                        <td>@project.ProjectName</td>
                                        <td>
                                            @if (project.ParentProject != null)
                                            {
                                                <span class="text-dark">@project.ParentProject.ProjectName</span>

                                            }
                                            else
                                            {
                                                <span class="text-dark">Main Project</span>

                                            }
                                        </td>

                                        <td>
                                            @if (project.AssignedUser != null)
                                            {
                                                @string.Join(", ", project.AssignedUser)

                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-controller="Projects" asp-action="DetailsP" asp-route-id="@project.Id" class="btn btn-sm btn-primary ">
                                                Detalis
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted">No projects available.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <!--Direct Tasks Section-->
    <div class="row">
        <div class="col">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white">
                    <h4 class="mb-0">Direct Tasks</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Task Title</th>
                                <th>Developer</th>
                                <th>Status</th>
                                <th>Estimated Date</th>
                                <th>Started On</th>
                                <th>Finished On</th>
                                <th>Over Due</th>
                               

                            </tr>
                        </thead>
                        <tbody>

                            @if (Model.DirectTasks != null && Model.DirectTasks.Any())
                            {
                                @foreach (var task in Model.DirectTasks)
                                {
                                    <tr>
                                        <td>
                                            <strong>@task.TaskName</strong><br />

                                        </td>

                                        <td>
                                            @if (task.AssignedUser != null)
                                            {
                                                @task.AssignedUser.UserName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>

                                        <td>
                                            <select class="form-select form-select-sm status-dropdown shadow-sm" data-task-id="@task.Id">
                                                <option value="0" selected="@(task.Status == PMSProject.Models.TaskStatus.NotStarted)">Not Started</option>
                                                <option value="1" selected="@(task.Status == PMSProject.Models.TaskStatus.OnHold)">On Hold</option>
                                                <option value="2" selected="@(task.Status == PMSProject.Models.TaskStatus.InProgress)">In Progress</option>
                                                <option value="3" selected="@(task.Status == PMSProject.Models.TaskStatus.Done)">Done</option>
                                                <option value="4" selected="@(task.Status == PMSProject.Models.TaskStatus.Canceled)">Canceled</option>
                                            </select>
                                        </td>
                                        <td>@task.EstimatedDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@task.StartedOn?.ToString("yyyy-MM-dd")</td>
                                        <td>@task.FinishedOn?.ToString("yyyy-MM-dd")</td>

                                        <td>
                                            @* Over Due  *@
                                            @if (task.EstimatedDate.HasValue
                                            && task.EstimatedDate.Value.Date < DateTime.Now.Date
                                            && task.Status != PMSProject.Models.TaskStatus.Done)
                                            {
                                                <span class="text-danger fw-bold">Over Due</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">On Track</span>
                                            }
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="text-center text-muted">No tasks available.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Project Tasks Section -->
    <div class="row">
        <div class="col">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Projects Tasks</h4>
                    <span class="badge bg-light text-dark fs-6 px-3 py-2 shadow-sm">
                        ✅ Completed Tasks: @ViewBag.CompletedCount
                    </span>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Task Title</th>
                                <th>Parent Project</th>
                                <th>sub-Project</th>
                                <th>Stage</th> 
                                <th>Developer</th>
                                <th>Sprint</th>
                                <th>Status</th>
                                <th>Estimated Date</th>
                                <th>Started On</th>
                                <th>Finished On</th>
                                <th>Over Due</th>
                           

                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ProjectTasks != null && Model.ProjectTasks.Any())
                            {
                                @foreach (var task in Model.ProjectTasks)
                                {
                                    <tr>
                                        <td>
                                            <strong>@task.TaskName</strong><br />

                                        </td>
                                        @* <!-- 2. المشروع الأب (Parent Project) --> *@
                                        <td>
                                            @if (task.Project?.ParentProject != null)
                                            {
                                                <span class="text-dark">@task.Project.ParentProject.ProjectName</span>
                                            }
                                            else
                                            {
                                                <span class="text-dark">@task.Project?.ProjectName</span>
                                            }
                                        </td>
                                        @* <!-- 3. المشروع الفرعي (Sub-Project) --> *@
                                        <td>
                                            @if (task.Project != null)
                                            {
                                                <span class="text-dark">@task.Project.ProjectName</span>
                                            }
                                            else
                                            {
                                                <span class="text-dark">No Project</span>
                                            }
                                        </td>

                                        <td>
                                            @if (task.Stage == TaskStage.Sprint)
                                            {
                                                <span class="badge bg-info">Sprint</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">BackLog</span>

                                            }
                                        </td>
                                        <td>
                                            @if (task.AssignedUser != null)
                                            {
                                                @task.AssignedUser.UserName
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not Assigned</span>
                                            }
                                        </td>
                                        <td>
                                            @if (task.Sprint != null)
                                            {
                                                <span>@task.Sprint.SprintName</span>
                                            }
                                            else
                                            {
                                                <span>No Sprint </span>
                                            }
                                        </td>
                                        <td>
                                            <select class="form-select form-select-sm status-dropdown shadow-sm" data-task-id="@task.Id">

                                                <option value="0" selected="@(task.Status == PMSProject.Models.TaskStatus.NotStarted)">Not Started</option>
                                                <option value="1" selected="@(task.Status == PMSProject.Models.TaskStatus.OnHold)">On Hold</option>
                                                <option value="2" selected="@(task.Status == PMSProject.Models.TaskStatus.InProgress)">In Progress</option>
                                                <option value="3" selected="@(task.Status == PMSProject.Models.TaskStatus.Done)">Done</option>
                                                <option value="4" selected="@(task.Status ==  PMSProject.Models.TaskStatus.Canceled)">Canceled</option>
                                            </select>
                                        </td>

                                        <td>@task.EstimatedDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@task.StartedOn?.ToString("yyyy-MM-dd")</td>
                                        <td>@task.FinishedOn?.ToString("yyyy-MM-dd")</td>

                                        <td>
                                            @* Over Due  *@
                                            @if (task.EstimatedDate.HasValue
                                            && task.EstimatedDate.Value.Date < DateTime.Now.Date
                                            && task.Status != PMSProject.Models.TaskStatus.Done)
                                            {
                                                <span class="text-danger fw-bold">Over Due</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">On Track</span>
                                            }
                                        </td>
  
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="6" class="text-center text-muted">No tasks available.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>


<!------------------ add task modal ------------------->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
<div class="modal-dialog modal-lg">
<div class="modal-content">
<form id="addTaskForm" asp-controller="Tasks" asp-action="CreateT" method="post">
<div class="modal-header bg-success text-white">
<h5 class="modal-title" id="addTaskModalLabel">Add New Task for @Model.User.UserName</h5>
<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
<!-- صندوق الأخطاء الداخلي داخل المودال -->
<div id="createTaskError" class="alert alert-danger d-none" role="alert"></div>
<!-- تعبئة ID المستخدم الحالي تلقائياً وغير قابل للتعديل -->
<input type="hidden" name="selectedUserId" value="@Model.User.Id" />
<div class="mb-3">
<label class="form-label">Task Name</label>
<input type="text" name="TaskName" class="form-control" required />
</div>
<div class="mb-3">
<label class="form-label">Project</label>
<select name="projectId" id="modalProjectId" class="form-control">
<option value="">-- Select Project --</option>
                           @if (Model.Projects != null)
                           {
                               @foreach (var p in Model.Projects)
                               {
<option value="@p.Id">@p.ProjectName</option>
                               }
                           }
</select>
</div>
<div class="mb-3">
<label class="form-label">Stage</label>
<select name="stage" class="form-control" asp-items="Html.GetEnumSelectList<PMSProject.Models.TaskStage>()">
<option value="">-- Select Stage --</option>
</select>
</div>
<div class="mb-3">
<label class="form-label">Sprint</label>
<select name="sprintId" id="modalSprintId" class="form-control">
<option value="">-- Select Sprint (Backlog) --</option>
                           @if (ViewBag.SprintsList != null)
                           {
                               foreach (var s in ViewBag.SprintsList)
                               {
<option value="@s.Value">@s.Text</option>
                               }
                           }
</select>
</div>
<div class="mb-3">
<label class="form-label">Task Notes / Details</label>
<textarea name="Notes" class="form-control" rows="3" placeholder="Add any notes or details about this task..."></textarea>
</div>
<div class="mb-3">
<label class="form-label">Status</label>
<select name="Status" id="modalStatus" class="form-control">
<option value="0">Not Started</option>
<option value="1">On Hold</option>
<option value="2">In Progress</option>
<option value="3">Done</option>
<option value="4">Canceled</option>
</select>
</div>
<div class="mb-3">
<label for="EstimatedDate" class="form-label">Estimated Date</label>
<input type="date" class="form-control" name="EstimatedDate" id="EstimatedDate" />
</div>
<div class="mb-3">
<label for="StartedOn" class="form-label">Started On</label>
<input type="date" class="form-control" name="StartedOn" id="StartedOn" />
</div>
<div class="mb-3">
<label for="FinishedOn" class="form-label">Finished On</label>
<input type="date" class="form-control" name="FinishedOn" id="FinishedOn" />
</div>
</div>
<div class="modal-footer">
<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
<button type="submit" class="btn btn-success">Save Task</button>
</div>
</form>
</div>
</div>
</div>

<script>
   $(document).ready(function() {
       // 1. مسح الأخطاء وإعادة تعيين الفورم عند إغلاق المودل
       $('#addTaskModal').on('hidden.bs.modal', function () {
           $(this).find('form')[0].reset();
           $('#createTaskError').addClass('d-none').text('');
       });
       // 2. التحقق من تاريخ الEstimated Date داخل المودل وإظهار الخطأ في صندوق التنبيه الأحمر
       $(document).on('change', 'input[name="EstimatedDate"]', function() {
           var modal = $(this).closest('.modal');
           var errorBox = modal.find('#createTaskError');
           var selectedDate = new Date($(this).val());
           var today = new Date();
           today.setHours(0, 0, 0, 0);
           if (selectedDate < today) {
               errorBox.text("Estimated date cannot be in the past").removeClass("d-none");
               $(this).val('');
           } else {
               errorBox.addClass("d-none");
           }
       });
       // 3. إرسال الفورم بالـ AJAX وإظهار الأخطاء إن وجدت داخل المودل نفسه دون الانتقال لصفحة أخرى
       $(document).on('submit', '#addTaskForm', function (e) {
           e.preventDefault();
           var form = $(this);
           var url = form.attr('action');
           var formData = form.serialize();
           var errorBox = $('#createTaskError');
           errorBox.addClass('d-none').text('');
           $.ajax({
               url: url,
               type: 'POST',
               data: formData,
               success: function (response) {
                   if (response.success) {
                       $('#addTaskModal').modal('hide');
                       location.reload();
                   } else {
                       var errorMsg = response.message || response.Message || "Please fill the required fields.";
                       errorBox.text(errorMsg).removeClass('d-none');
                   }
               },
               error: function (xhr) {
                   errorBox.text('Server Error (' + xhr.status + '): حدث خطأ أثناء الاتصال بالخادم.').removeClass('d-none');
               }
           });
       });
   });
</script>
    <script>
        $(document).on('change', '.status-dropdown', function () {
           let $dropdown = $(this);
           let taskId = $dropdown.data('task-id');
           let newStatus = $dropdown.val();
           // إرسال الطلب عبر الـ AJAX
           $.ajax({
               url: '/Tasks/UpdateTaskStatus',
               type: 'POST',
               data: {
                   taskId: taskId,
                   newStatus: newStatus
               },
               success: function (response) {
                   console.log("server resonse :",response);
                   if (response.success) {
                       console.log("Status updated successfully");
                   } else {
                       alert("Error: " + response.message);
                   }
               },
               error: function (xhr) {
                   console.error("AJAX Error:", xhr.responseText);
                   alert("An error occurred while updating the status.");
               }
           });
        });
      


    </script>