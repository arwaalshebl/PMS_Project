@model PMSProject.Models.TaskModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create New Task</h4>
                </div>

                <div class="card-body">
                    <form asp-action="CreateT" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Task Title / Name -->
                        <div class="mb-3">
                            <label asp-for="TaskName" class="form-label font-weight-bold">Task Title</label>
                            <input asp-for="TaskName" class="form-control" placeholder="Enter task title..." />
                            <span asp-validation-for="TaskName" class="text-danger"></span>
                        </div>

                        <!-- Project Selection -->
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Project</label>
                            <select name="projectId" id="ProjectId" class="form-select" asp-items="ViewBag.ProjectsList">
                                <option value="">-- Select Project --</option>
                              
                            </select>
                        </div>

                        <!-- Developer Selection -->
                        <div class="mb-3">
                            <label class="form-label font-weight-bold">Developer</label>
                            <select name="selectedUserId" id="DeveloperId" class="form-select" asp-items="ViewBag.Users">
                                <option value="">-- Select Developer --</option>
                             
                            </select>
                        </div>
                        <!-- Sprint Selection -->

                        <div class="mb-3">
                            <label class="form-label">Sprint</label>
                            <select name="SprintId" id="modalSprintId" class="form-control" asp-items="ViewBag.SprintsList">
                                <option value="">-- Select Sprint (Backlog) --</option>
                            </select>
                        </div>
                        <!-- Submit Button -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary me-md-2">Back to Dashboard</a>
                            <button type="submit" class="btn btn-success">Create Task</button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const devSelect = document.getElementById("DeveloperId");
            const projSelect = document.getElementById("ProjectId");

            if (projSelect) {
                projSelect.addEventListener("change", function () {
                    let projectId = this.value;

                    if (!projectId) {
                        devSelect.innerHTML = '<option value="">-- Select Developer --</option>';
                        return;
                    }

                    fetch(`/Tasks/GetDevelopersByProject?projectId=${projectId}`)
                        .then(response => response.json())
                        .then(developers => {
                            devSelect.innerHTML = '<option value="">-- Select Developer --</option>';
                            developers.forEach(dev => {
                                let option = document.createElement("option");
                                option.value = dev.id;
                                option.textContent = dev.userName;
                                devSelect.appendChild(option);
                            });
                        })
                        .catch(error => console.error('Error:', error));
                });
            }
        });
    </script>
}
