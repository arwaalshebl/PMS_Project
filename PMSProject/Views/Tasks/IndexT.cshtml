@model IEnumerable<PMSProject.Models.TaskModel>

<div class="container mt-4">
    <!-- Header Section and Action Buttons -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold text-dark">Tasks List</h2>
        <div class="d-flex gap-2">
            <a asp-action="CreateT" class="btn btn-success px-4 shadow-sm">
                Create New Task
            </a>
            <a asp-controller="Projects" asp-action="CreateP" class="btn btn-outline-primary px-4">
                Submit New Project
            </a>
            <a asp-controller="Projects" asp-action="IndexP" class="btn btn-outline-primary px-4">
                List of Projects
            </a>
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-secondary me-md-2">Back to Dashboard</a>

        </div>
    </div>

    <!-- Data Table Container -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary font-weight-bold">
                    <tr>
                        <th class="ps-4">Task Name</th>
                        <th>Status</th>
                        <th>Stage</th>
                        <th>Related Project</th>
                        <th>Developer</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No tasks available. Click "Create New Task" to begin.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark ps-4">@item.TaskName</td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success py-1.5 px-2.5 rounded border border-success border-opacity-25">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.Stage</td>
                                <td>
                                    @if (item.Project != null )
                                    {
                                        <span class="text-muted">
                                            @string.Join(", ", item.Project)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7 italic">None</span>
                                    }
                                </td>
                                <td>
                                    @if (item.AssignedUser != null )
                                    {
                                        <span class="fw-semibold text-success">
                                            @string.Join(", ", item.AssignedUser)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-7">Not Assigned</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">
                                            Edit
                                        </a>
                                        <a asp-action="DeleteT" asp-route-id="@item.Id" class="btn btn-sm btn-danger"
                                           onclick="return confirm('Are you sure you want to delete this task?');">
                                            Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
