@model PMSProject.Models.ProjectModel
<h2>Add New Project</h2>
<form asp-action="CreateP">
    <div class="form-group">
        <label>Project Name</label>
        <input asp-for="ProjectName" class="form-control" />
    </div>
    <div class="form-group">
        <label>To multiple choose press Ctrl</label>
        @if (ViewBag.Users != null && ViewBag.Users.Count > 0)
        {
            <select name="selectedUsersIds" class="form-control" multiple>
                @foreach (var user in ViewBag.Users)
                {
                    <option value="@user.Id">@user.UserName</option>
                }
            </select>

        }

        else
        {
            <p>No Available Developers</p>
        }

    </div>
    <div class="form-group">
        <label>Note</label>
        <textarea asp-for="Note" class="form-control"></textarea>
    </div>
    <br />
    <button type="submit" class="btn btn-primary">Save Project</button>
</form>