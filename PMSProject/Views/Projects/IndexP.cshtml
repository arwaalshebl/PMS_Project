@model IEnumerable<PMSProject.Models.ProjectModel>
<h2>Project List </h2>
<a asp-action="CreateP" class="btn btn-primary rounded-pill px-4">
    Submit New Project
</a>
<a asp-controller="Tasks" asp-action="CreateT" class="btn btn-success rounded-pill px-4">
    Submit New Task
</a>
<a asp-controller="Tasks" asp-action="IndexT" class="btn btn-success rounded-pill px-4">
    List of tasks
</a>
<table class="table">
    <thead>
        <tr>
            <th>Project Name</th>

            <th>Developer</th>
            <th>Action</th>

        </tr>
    </thead>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ProjectName</td>
            <td>
                @if (item.AssignedUser != null )
                {
                    @string.Join(", ", item.AssignedUser)

                }
                else
                {
                    <span class="text-muted">Not Assigned</span>
                }

            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a class="btn-danger" asp-action="DeleteP" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>

    }
</table>