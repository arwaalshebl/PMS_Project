<div class="modal fade" id="addPublishModal" tabindex="-1" aria-labelledby="addPublishModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addPublishForm" asp-controller="Projects" asp-action="CreatePublish" method="post">
