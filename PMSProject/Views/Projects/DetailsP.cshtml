           });
        });

      

    </script>
    <script>
        $(document).ready(function() {
           // التحقق عند تغيير تاريخ الـ Estimated Date في أي مودل (إضافة أو تعديل)
           $(document).on('change', 'input[name="EstimatedDate"]', function() {
               var modal = $(this).closest('.modal');
               // التأكد من وجود صندوق التنبيه الأحمر داخل المودل، وإذا لم يوجد يتم إضافته تلقائياً في الأعلى
               var errorBox = modal.find('.alert-danger');
               if (errorBox.length === 0) {
                   modal.find('.modal-body').prepend('<div class="alert alert-danger d-none" role="alert"></div>');
                   errorBox = modal.find('.alert-danger');
               }
               var selectedDate = new Date($(this).val());
               var today = new Date();
               today.setHours(0, 0, 0, 0); // تصفير الوقت للمقارنة السليمة
               // الشرط: إذا كان التاريخ المختار أصغر من تاريخ اليوم
               if (selectedDate < today) {
                   errorBox.text("Estimated date cannot be in the past").removeClass("d-none"); // إظهار التنبيه الأحمر
                   $(this).val(''); // تفريغ الحقل الخاطئ
               } else {
                   errorBox.addClass("d-none"); // إخفاء التنبيه إذا كان التاريخ صحيحاً
               }
           });
        });
    </script>

}
