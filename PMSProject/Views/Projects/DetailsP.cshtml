                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Publish</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
<script>
       $(document).ready(function () {
           // مودال التعديل
           $('#editTaskModal').on('show.bs.modal', function (event) {
               var button = $(event.relatedTarget);
               var id = button.data('id');
               $.get('/Home/GetTask/' + id, function (data) {
                   $('#TaskId').val(data.id);
                   $('#TaskName').val(data.taskName);
                   $('#TaskUserId').val(data.userId);
                   $('#modalProjectId').val(data.projectId);
                   $('#modalStatus').val(data.status);
                   $('#modalStage').val(data.stage);
                    $('#modalSprintId').val(data.sprintId);


                   $('#Note').val(data.note);
                   $('#EstimatedDate').val(data.estimatedDate ? data.estimatedDate.substring(0, 10) : '');
                   $('#StartedOn').val(data.startedOn ? data.startedOn.substring(0, 10) : '');
                   $('#FinishedOn').val(data.finishedOn ? data.finishedOn.substring(0, 10) : '');
               });
           });
           // مودال التفاصيل
           $('#taskDetailsModal').on('show.bs.modal', function (event) {
               var button = $(event.relatedTarget);
               var id = button.data('id');
               $.get('/Home/GetTask/' + id, function (data) {
                   $('#detailsTaskName').val(data.taskName);
                   $('#detailsProjectName').val(data.projectName);
                   $('#detailsDeveloper').val(data.userName);
                   $('#detailsSprint').val(data.sprintName);
                var stageText = (data.stage === 0 )? "Sprint" : "Backlog";

                $('#detailsStage').val(stageText);

               

                /// اذا كانت المهمه ماعنده مشروع (direct task) تختفي خانة السبرنت
                if(data.projectName ==="N/A")
                {
                     $('#sprintContainer').hide();
                     $('#stageContainer').hide();



                }else{
                     $('#sprintContainer').show();
                     $('#stageContainer').show();


                }
                   let statusMap = {
                       0: "Not Started",
                       1: "On Hold",
                       2: "In Progress",
                       3: "Done",
                       4: "Canceled"
                   };
                   let statusText = statusMap[data.status] !== undefined ? statusMap[data.status] : data.status;
                   $('#detailsStatus').val(statusText);
                   $('#detailsNote').val(data.note);
                   $('#detailsEstimatedDate').val(data.estimatedDate ? data.estimatedDate.substring(0, 10) : '');
                   $('#detailsStartedOn').val(data.startedOn ? data.startedOn.substring(0, 10) : '');
                   $('#detailsFinishedOn').val(data.finishedOn ? data.finishedOn.substring(0, 10) : '');
               });
           });
           // تغيير الحالة تلقائياً عند تغيير التواريخ
           $(document).on('change', '#StartedOn', function () {
               var modal = $(this).closest('.modal');
               var statusSelect = modal.find("select[name='Status']");
               if ($(this).val() && (statusSelect.val() == "0" || statusSelect.val() === "")) {
                   statusSelect.val("2"); // In Progress
               }
           });
           $(document).on('change', '#FinishedOn', function () {
               var modal = $(this).closest('.modal');
               var statusSelect = modal.find("select[name='Status']");
               if ($(this).val()) {
                   statusSelect.val("3"); // Done
               }
           });
       });
</script>
    <script>
        $(document).ready(function () {
            $('#addTaskModal').on('show.bs.modal', function (event) {
                var projectId = $('#modalProjectId').val();
                var targetDeveloperId = $('#modalAssignedUserId').val();
                var $devIdInput = $('#modalUserId');
                if (!projectId) return;
                // استدعاء المطورين الخاصين بهذا المشروع
                $.ajax({
                    url: '/Tasks/GetDevelopersByProject',
                    type: 'GET',
                    data: { projectId: projectId },
                    success: function (data) {
                        $devIdInput.empty();
                        $devIdInput.append('<option value="">-- Unassigned --</option>');
                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                let id = item.id || item.Id;
                                let name = item.userName || item.UserName || item.name || item.Name;
                                $devIdInput.append($('<option>', { value: id, text: name }));
                            });
                        }
                        // تحديد المطور المسند للمشروع تلقائياً بعد تعبئة القائمة
                        if (targetDeveloperId) {
                            $devIdInput.val(targetDeveloperId);
                        }
                    },
                    error: function (xhr) {
                        console.error("Error fetching developers:", xhr.responseText);
                    }
                });
            });
            // مسح الأخطاء وإعادة تعيين الفورم عند إغلاق المودال
            $('#addTaskModal').on('hidden.bs.modal', function () {
                $(this).find('form')[0].reset();
                $('#createTaskError').addClass('d-none').text('');
            });
            // إرسال الفورم بالـ AJAX لمنع إعادة تحميل الصفحة
            $(document).on('submit', '#addTaskForm', function (e) {
                e.preventDefault();
                var form = $(this);
                var url = form.attr('action');
                var formData = form.serialize();
                $('#createTaskError').addClass('d-none').text('');
                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            $('#addTaskModal').modal('hide');
                            location.reload();
                        } else {
                            var errorMsg = response.message || response.Message || "Please fill the required fields.";
                            $('#createTaskError').text(errorMsg).removeClass('d-none');
                        }
                    },
                    error: function (xhr) {
                        $('#createTaskError').text('Server Error: حدث خطأ أثناء الاتصال بالخادم.').removeClass('d-none');
                    }
                });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            $('#editProjectModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                // تحقق من وجود الـ id لتجنب أي طلبات خاطئة
                if (!id) return;
                // جلب البيانات عبر الـ AJAX وتعبئتها في الحقول الجديدة بدقة
                $.get('/Home/GetProject/' + id)
                    .done(function (data) {
                        if (data) {
                            $('#Edit_ProjectId').val(data.id);
                            $('#Edit_ProjectName').val(data.projectName);
                            $('#Edit_ProjectUserId').val(data.userId);
                            $('#Edit_Note').val(data.note);
                            $('#Edit_Weight').val(data.weight);
                        }
                    })
                    .fail(function (xhr) {
                        console.error("Error fetching project data: " + xhr.statusText);
                    });
            });
        });
    </script>
    <script>
        $(document).ready(function () {
            // إعادة تعيين الفورم ومسح الأخطاء عند إغلاق المودال
            $('#addPublishModal').on('hidden.bs.modal', function () {
                $(this).find('form')[0].reset();
                $('#createPublishError').addClass('d-none').text('');
            });
            // إرسال الفورم الخاص بـ Publish عبر الـ AJAX
            $(document).on('submit', '#addPublishForm', function (e) {
